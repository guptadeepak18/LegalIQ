{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "esbuild src/__tests__/caseStudies.test.ts --bundle --platform=node --format=esm --outfile=/tmp/legaliq-caseStudies.test.mjs && node /tmp/legaliq-caseStudies.test.mjs && esbuild src/__tests__/reportPdf.test.ts --bundle --platform=node --format=esm --outfile=/tmp/legaliq-reportPdf.test.mjs && node /tmp/legaliq-reportPdf.test.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.35",
    "@clerk/shared": "^4.23.0",
    "@google/genai": "^1.10.0",
    "@replit/connectors-sdk": "^0.4.2",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "@types/uuid": "^11.0.0",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
