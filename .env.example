# ==============================================================================
# LegalIQ Environment Configuration Guide
# Rename this file to .env or supply these variables in AWS App Runner / ECS
# ==============================================================================

# ── General Server Settings ───────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
# Public domain where the app is reached (e.g. https://www.lhs.restthecase.in)
APP_URL=https://www.lhs.restthecase.in
LOG_LEVEL=info

# ── Database (PostgreSQL 16) ──────────────────────────────────────────────────
# AWS RDS PostgreSQL connection string (or local Docker Postgres)
# Example: postgresql://<user>:<password>@<rds-host>.rds.amazonaws.com:5432/<dbname>?sslmode=require
DATABASE_URL=postgresql://legaliq_user:legaliq_secure_password@postgres:5432/legaliq

# ── Admin Authentication (JWT + Bcrypt) ───────────────────────────────────────
# Secure random secret used to sign admin JWT tokens (64-char hex string)
JWT_SECRET=generate_a_random_64_char_hex_secret_here

# Password for initial bootstrap admin (info@restthecase.com) created on first boot
ADMIN_BOOTSTRAP_PASSWORD=Admin@12345678

# ── AI Engines (Groq / Google Gemini) ─────────────────────────────────────────
# Groq provides ultra-low latency (<100ms) and high free-tier limits: https://console.groq.com/
GROQ_API_KEY=gsk_...
# Optional override (defaults to openai/gpt-oss-120b -> llama-3.3-70b-versatile -> llama-3.1-8b-instant)
GROQ_MODEL=

# Google Gemini (fallback / optional if using Groq): https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...

# ── Clerk Identity Verification ───────────────────────────────────────────────
# Obtain from your Clerk Dashboard: https://dashboard.clerk.com/
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
# Frontend key (matches CLERK_PUBLISHABLE_KEY, injected during build)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
# Optional: only if using custom proxy path
# VITE_CLERK_PROXY_URL=/api/__clerk

# ── AWS Storage (Amazon S3) ───────────────────────────────────────────────────
# Bucket for storing certificate templates, generated client certificates, and report PDFs
AWS_REGION=ap-south-1
AWS_S3_BUCKET=legaliq-assets
AWS_S3_PREFIX=production

# AWS IAM credentials (omit if using IAM Task Role on App Runner or ECS)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI...

# ── Email Delivery (AWS SES or SMTP) ──────────────────────────────────────────
# If using AWS SES: ensure AWS_REGION and IAM credentials have ses:SendRawEmail permission.
# Alternatively, if you prefer SMTP (e.g. Gmail App Password, Sendgrid, Mailgun):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=info@restthecase.com
# SMTP_PASS=your-16-char-app-password

# ── SMS Notifications (Optional) ──────────────────────────────────────────────
# FAST2SMS_API_KEY=your_fast2sms_api_key_here
